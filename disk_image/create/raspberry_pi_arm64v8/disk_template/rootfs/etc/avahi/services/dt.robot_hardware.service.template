<?xml version="1.0" standalone='no'?><!--*-nxml-*-->
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
    <name replace-wildcards="yes">DT::ROBOT_HARDWARE::%h</name>
    <service>
        <type>_duckietown._tcp</type>
        <txt-record>{"hardware": "NOTSET"}</txt-record>
        <port>0</port>
    </service>
</service-group>
